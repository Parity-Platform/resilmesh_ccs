<!-- EV Charging Station Security Rules -->
<!-- Place this file in /var/ossec/etc/rules/local_rules.xml on Wazuh Manager -->

<group name="ev_charger,local,">

  <!-- Rule for EV Charger Heartbeat -->
  <rule id="100001" level="1">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">heartbeat</field>
    <description>EV Charger heartbeat received</description>
    <group>ev_charger,heartbeat</group>
  </rule>

  <!-- Rule for Charging Session Start -->
  <rule id="100002" level="3">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">charging_session_start</field>
    <description>EV Charging session started</description>
    <group>ev_charger,session</group>
  </rule>

  <!-- Rule for Charging Session End -->
  <rule id="100003" level="3">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">charging_session_end</field>
    <description>EV Charging session completed</description>
    <group>ev_charger,session</group>
  </rule>

  <!-- Rule for High CPU Usage -->
  <rule id="100004" level="7">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">HIGH_CPU_USAGE</field>
    <description>EV Charger: High CPU usage detected</description>
    <group>ev_charger,performance,cpu</group>
  </rule>

  <!-- Rule for High Memory Usage -->
  <rule id="100005" level="7">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">HIGH_MEMORY_USAGE</field>
    <description>EV Charger: High memory usage detected</description>
    <group>ev_charger,performance,memory</group>
  </rule>

  <!-- Rule for High Temperature -->
  <rule id="100006" level="8">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">HIGH_TEMPERATURE</field>
    <description>EV Charger: High temperature detected</description>
    <group>ev_charger,hardware,temperature</group>
  </rule>

  <!-- Rule for Voltage Anomaly -->
  <rule id="100007" level="10">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">VOLTAGE_ANOMALY</field>
    <description>EV Charger: Critical voltage anomaly detected</description>
    <group>ev_charger,hardware,voltage,critical</group>
  </rule>

  <!-- Rule for Port Scan Detection -->
  <rule id="100008" level="8">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">PORT_SCAN</field>
    <description>EV Charger: Port scan detected</description>
    <group>ev_charger,attack,reconnaissance</group>
  </rule>

  <!-- Rule for Brute Force Attack -->
  <rule id="100009" level="10">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">BRUTE_FORCE</field>
    <description>EV Charger: Brute force attack detected</description>
    <group>ev_charger,attack,brute_force</group>
  </rule>

  <!-- Rule for DDoS Attempt -->
  <rule id="100010" level="12">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">DDoS_ATTEMPT</field>
    <description>EV Charger: DDoS attack attempt detected</description>
    <group>ev_charger,attack,ddos</group>
  </rule>

  <!-- Rule for Malware Communication -->
  <rule id="100011" level="12">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">MALWARE_COMMUNICATION</field>
    <description>EV Charger: Malware communication detected</description>
    <group>ev_charger,malware,c2</group>
  </rule>

  <!-- Rule for Unauthorized Access -->
  <rule id="100012" level="10">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">UNAUTHORIZED_ACCESS</field>
    <description>EV Charger: Unauthorized access attempt</description>
    <group>ev_charger,attack,unauthorized</group>
  </rule>

  <!-- Rule for Multiple Authentication Failures -->
  <rule id="100013" level="8">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">MULTIPLE_AUTH_FAILURES</field>
    <description>EV Charger: Multiple authentication failures</description>
    <group>ev_charger,authentication,failure</group>
  </rule>

  <!-- Rule for Authentication Failure -->
  <rule id="100014" level="5">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">authentication_failure</field>
    <description>EV Charger: Authentication failure</description>
    <group>ev_charger,authentication</group>
  </rule>

  <!-- Rule for System Health Issues -->
  <rule id="100015" level="5">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">system_health</field>
    <field name="cpu_percent">^[89]\d\.\d+|^9[0-9]\.\d+|^100\.0$</field>
    <description>EV Charger: High CPU usage in system health report</description>
    <group>ev_charger,performance</group>
  </rule>

  <!-- Rule for Network Security Events -->
  <rule id="100016" level="6">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">network_status</field>
    <description>EV Charger: Network status update</description>
    <group>ev_charger,network</group>
  </rule>

  <!-- Rule for Firmware Update Events -->
  <rule id="100017" level="3">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">firmware_update</field>
    <description>EV Charger: Firmware update event</description>
    <group>ev_charger,firmware</group>
  </rule>

  <!-- Rule for Payment Processing -->
  <rule id="100018" level="3">
    <decoded_as>ev-charger</decoded_as>
    <field name="payment_method">Credit_Card|Mobile_App|RFID</field>
    <description>EV Charger: Payment processing event</description>
    <group>ev_charger,payment</group>
  </rule>

  <!-- Rule for Unusual Energy Consumption -->
  <rule id="100019" level="7">
    <decoded_as>ev-charger</decoded_as>
    <field name="energy_consumed_kwh">^[5-9]\d\.\d+|^[1-9]\d{2,}\.\d+$</field>
    <description>EV Charger: Unusual high energy consumption detected</description>
    <group>ev_charger,energy,anomaly</group>
  </rule>

  <!-- Rule for Rapid Session Changes -->
  <rule id="100020" level="8" frequency="5" timeframe="60">
    <if_matched_sid>100002</if_matched_sid>
    <same_charger_id />
    <description>EV Charger: Rapid charging session starts (possible attack)</description>
    <group>ev_charger,attack,session_abuse</group>
  </rule>

  <!-- Rule for Offline Charger -->
  <rule id="100021" level="10">
    <decoded_as>ev-charger</decoded_as>
    <field name="status">offline|error|fault</field>
    <description>EV Charger: Charger reported as offline or in error state</description>
    <group>ev_charger,availability,critical</group>
  </rule>

  <!-- Rule for Suspicious Network Traffic -->
  <rule id="100022" level="9">
    <decoded_as>traffic-generator</decoded_as>
    <field name="traffic_type">malicious</field>
    <description>EV Network: Malicious traffic pattern detected</description>
    <group>ev_charger,network,attack</group>
  </rule>

  <!-- Rule for Data Exfiltration -->
  <rule id="100023" level="12">
    <decoded_as>traffic-generator</decoded_as>
    <field name="pattern">data_exfiltration</field>
    <description>EV Network: Data exfiltration attempt detected</description>
    <group>ev_charger,attack,exfiltration</group>
  </rule>

  <!-- Rule for Malware Beacon -->
  <rule id="100024" level="12">
    <decoded_as>traffic-generator</decoded_as>
    <field name="beacon_type">malware_c2</field>
    <description>EV Network: Malware beacon to C&amp;C server detected</description>
    <group>ev_charger,malware,beacon</group>
  </rule>

  <!-- Rule for Physical Tampering -->
  <rule id="100025" level="10">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">PHYSICAL_TAMPERING</field>
    <description>EV Charger: Physical tampering detected</description>
    <group>ev_charger,physical,tampering</group>
  </rule>

  <!-- Rule for Firmware Integrity Violation -->
  <rule id="100026" level="12">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">FIRMWARE_INTEGRITY</field>
    <description>EV Charger: Firmware integrity violation detected</description>
    <group>ev_charger,firmware,integrity</group>
  </rule>

  <!-- Rule for Emergency Stop -->
  <rule id="100027" level="8">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">EMERGENCY_STOP</field>
    <description>EV Charger: Emergency stop activated</description>
    <group>ev_charger,safety,emergency</group>
  </rule>

  <!-- Composite Rule: Multiple security events from same charger -->
  <rule id="100028" level="12" frequency="3" timeframe="300">
    <if_matched_group>ev_charger,attack</if_matched_group>
    <same_charger_id />
    <description>EV Charger: Multiple security events from same charger (coordinated attack)</description>
    <group>ev_charger,attack,coordinated</group>
  </rule>

  <!-- Rule for Geofencing Violation -->
  <rule id="100029" level="8">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">GEOFENCING_VIOLATION</field>
    <description>EV Charger: Device location outside permitted area</description>
    <group>ev_charger,location,violation</group>
  </rule>

  <!-- Rule for Time-based Anomaly -->
  <rule id="100030" level="6">
    <decoded_as>ev-charger</decoded_as>
    <field name="event_type">charging_session_start</field>
    <time>02:00-05:00</time>
    <description>EV Charger: Unusual charging session during night hours</description>
    <group>ev_charger,timing,anomaly</group>
  </rule>

</group>