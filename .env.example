# Copy this file to .env and set strong, unique values before starting the stack.
# Do not commit .env. Never reuse these values in production.

# Wazuh demo stack credentials (required by docker-compose.yml)
WAZUH_INDEXER_PASSWORD=
WAZUH_API_PASSWORD=
WAZUH_DASHBOARD_PASSWORD=

# Valkey / Redis
REDIS_PASSWORD=

# MISP database credentials
MYSQL_USER=misp
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=misp

# MISP administrator and application keys
ADMIN_EMAIL=
ADMIN_ORG=
ADMIN_KEY=
ADMIN_PASSWORD=
GPG_PASSPHRASE=
ENCRYPTION_KEY=

# Enrichment API credentials
API_KEY=
MISP_API_KEY=

# Optional service settings
RSYSLOG_HOST=
RSYSLOG_PORT=10514
MISP_API_URL=https://misp-core:8443
NATS_URL=nats://nats:4222
MISP_CERTIFICATE_VERIFY=1
SUBSCRIBE_SUBJECT=enriched_events
SUBSCRIBE_QUEUE=misp_queue
